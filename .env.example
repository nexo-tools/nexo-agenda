APP_NAME="Nexo Agenda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. The values below target the shared local Docker stack `nexo`
# (MySQL on host port 3307); this repo's compose.yaml only runs the app runtime,
# so the database is reached through host.docker.internal.
# SELF-HOSTING: point these at your own MySQL — see DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=nexoagenda
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (HTTPS) set these to harden the session cookie:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8101
VITE_PORT=5176

# Nexo ecosystem (shared chrome: app-switcher + footer). The registry lives in
# config/nexo-ecosystem.php. Leave CURRENT unset for a standalone instance with
# no ecosystem identity.
NEXO_ECOSYSTEM_CURRENT=nexoagenda
# NEXO_HUB_URL=https://nexotools.alvarocdev.com
# NEXO_GITHUB_ORG=https://github.com/nexo-tools

# Cookieless ecosystem analytics (opt-in). Off by default; when true, an
# anonymous pageview beacon is sent to the Nexo Tools hub. See config/nexo.php.
NEXO_BEACON_ENABLED=false

# Footer attribution ("powered by") — canonical name/shape across every Nexo tool.
# Attribution shown in the footer. Leave unset and the tool shows its own
# neutral default ("made with Nexo Agenda"). A third-party instance must NOT advertise
# the upstream author; set your own here.
# NEXO_ATTRIBUTION_LABEL="powered by yoursite.com"
# NEXO_ATTRIBUTION_URL="https://yoursite.com"

# Who operates this instance, named on /privacidad and /terminos. This tool holds
# third-party data (the name/email/phone of whoever books an appointment), so the
# data controller of THIS deployment has to be identifiable — it is you, not the
# upstream author. Unset, the pages omit the section and point at /contacto.
# NEXO_LEGAL_OPERATOR="Your name or company"
# NEXO_LEGAL_CONTACT="privacy@yoursite.com"

# Nexo ID SSO (optional). Off by default: the app runs standalone with local
# accounts. Enable to add "Continuar con Nexo ID" login against a Nexo ID instance
# (OIDC + PKCE). A first SSO sign-up creates the user, then onboarding collects the
# business. Register the client on the provider with an exact redirect of
# {APP_URL}/auth/nexo/callback (php artisan nexo:sso-client).
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=
# Silent SSO (prompt=none) rides NEXO_SSO_ENABLED; set false to kill-switch it per tool.
NEXO_SSO_SILENT=true
# Where Nexo ID returns the browser after a central (RP-initiated) logout. Register
# this exact URI on the provider or it lands on Nexo ID's own "signed out" page.
NEXO_SSO_POST_LOGOUT_REDIRECT_URI=https://nexoagenda.alvarocdev.com
